<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_data_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/live_widget_background">

    <TextView
        android:id="@+id/live_widget_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="○ MQTT нет соединения"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/live_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Настройте виджет"
        android:textColor="#D0FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/live_widget_value"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="—"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/live_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:text="Обновляется из MQTT в реальном времени"
        android:textColor="#B8FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
